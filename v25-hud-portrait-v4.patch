+/** Di perangkat sentuh tidak ada tombol E: petunjuk "[E]" diganti nama tombol di layar. */
+function adaptKeyHints(text: string): string {
+  if (typeof window === 'undefined' || typeof window.matchMedia !== 'function') return text;
+  if (!text.includes('[E]')) return text;
+  return window.matchMedia('(pointer: coarse)').matches ? text.replace(/\[E\]/g, 'AKSI') : text;
+}
+
+function adaptDeep(node: unknown): unknown {
+  if (typeof node === 'string') return adaptKeyHints(node);
+  if (Array.isArray(node)) return node.map(adaptDeep);
+  if (node && typeof node === 'object') {
+    return Object.fromEntries(Object.entries(node as Record<string, unknown>).map(([k, v]) => [k, adaptDeep(v)]));
+  }
+  return node;
+}
